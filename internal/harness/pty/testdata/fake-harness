#!/bin/sh
# A terminal fixture: reports its working directory/size and echoes input.
if [ "${1:-}" = ignore-term ]; then
  trap '' TERM
fi
printf 'fake harness ready pid=%s cwd=%s\n' "$$" "$PWD"
stty size
if [ "${1:-}" = exit ]; then
  exit 7
fi
while IFS= read -r line; do
  case "$line" in
    size) printf 'size='; stty size ;;
    exit) printf 'final output before exit\n'; exit 0 ;;
    fail) exit 7 ;;
    *) printf 'received: %s\n' "$line" ;;
  esac
done
